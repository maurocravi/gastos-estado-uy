---
import '../styles/global.css';
// Fuentes self-hosted (@fontsource): mejor que el CDN de Google por
// privacidad y velocidad. Sans para UI, Mono para números.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * `false` en las páginas que se sirven bajo muchas URLs por los rewrites de
   * `_redirects` (los detalles client-side): un canonical fijo le diría a
   * Google que las 130k compras son la misma página. Sin la etiqueta usa la
   * URL que rastreó, que es la correcta.
   */
  canonical?: false;
  /** Structured data extra de la página, que se suma al `WebSite` del sitio. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonical, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · Compras del Estado` : 'Compras del Estado · Uruguay';
const pageDescription =
  description ??
  'Datos abiertos de compras y adjudicaciones del Estado uruguayo (fuente: ARCE, formato OCDS).';

// Cloudflare Pages canonicaliza CON barra final (`/compras` → 308 →
// `/compras/`): el canonical tiene que usar esa forma o se contradice con lo
// que realmente se sirve.
const ruta = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical === false ? undefined : new URL(ruta, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt =
  'Compras del Estado · Qué compra el Estado uruguayo, a quién y a qué precio. Datos abiertos, fuente ARCE / OCDS.';

// Structured data. `WebSite` describe al sitio y va en todas las páginas; las
// páginas que aportan algo más (la home describe el dataset) lo suman por prop.
const sitio = {
  '@type': 'WebSite',
  '@id': `${Astro.site}#website`,
  url: Astro.site!.href,
  name: 'Compras del Estado',
  description: pageDescription,
  inLanguage: 'es-UY',
  publisher: { '@id': `${Astro.site}#publisher` },
};
const editor = {
  '@type': 'Organization',
  '@id': `${Astro.site}#publisher`,
  name: 'Compras del Estado',
  url: Astro.site!.href,
  // Proyecto independiente: los datos son del Estado, el sitio no.
  description:
    'Proyecto independiente que publica los datos abiertos de compras del Estado uruguayo en formato consultable.',
};
const grafo = [sitio, editor, ...(jsonLd ? [jsonLd] : [])];

const nav = [
  { href: '/', label: 'Resumen' },
  { href: '/organismos', label: 'Organismos' },
  { href: '/proveedores', label: 'Proveedores' },
  { href: '/compras', label: 'Compras' },
  { href: '/precios', label: 'Precios' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Safari no soporta favicons SVG: cae al PNG. -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <!-- Los navegadores y crawlers piden /favicon.ico aunque no esté declarado:
         sin el archivo es un 404 en cada visita. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{pageTitle}</title>

    <!-- Open Graph: sin esto el link compartido en WhatsApp/X sale en blanco. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Compras del Estado" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo })} is:inline />
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <!-- Barra superior fina -->
    <header class="sticky top-0 z-10 border-b border-line bg-surface">
      <div class="flex h-12 items-center gap-3 px-5">
        <a href="/" class="flex items-baseline gap-2">
          <span class="text-sm font-semibold tracking-tight text-primary-deep">
            Compras del Estado
          </span>
          <span class="hidden text-xs text-ink-faint sm:inline">Uruguay · datos abiertos</span>
        </a>
        <span class="ml-auto text-xs text-ink-faint">fuente: ARCE / OCDS</span>
      </div>
    </header>

    <div class="flex">
      <!-- Sidebar angosto -->
      <aside class="sticky top-12 hidden h-[calc(100vh-3rem)] w-48 shrink-0 border-r border-line px-3 py-6 md:block">
        <nav class="flex flex-col gap-1">
          {
            nav.map((item) => {
              const active = path === item.href;
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-3 py-1.5 text-sm',
                    active
                      ? 'bg-primary-tint font-medium text-primary'
                      : 'text-ink-soft hover:bg-primary-tint/50 hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </aside>

      <!-- Contenido: grilla de 12, ancho máximo 1280 -->
      <main class="min-w-0 flex-1">
        <div class="mx-auto grid max-w-[1280px] grid-cols-12 gap-6 px-5 py-10 lg:px-10">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
