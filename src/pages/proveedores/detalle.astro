---
import Layout from '../../layouts/Layout.astro';

// Página única (cáscara) para la ficha de proveedor: los ~6.000 proveedores
// como páginas estáticas superan con los años el límite de 20k archivos de
// Cloudflare Pages. En producción /proveedores/{slug} lo atiende la Pages
// Function functions/proveedores/[id].ts, que toma esta cáscara y le inyecta
// la ficha ya armada (título, descripción, canonical y contenido). En dev el
// middleware hace el rewrite y el script de abajo la arma en el cliente. La
// publishable key es pública por diseño (solo lectura vía RLS); la Function
// también la lee de acá.
const supabaseUrl = import.meta.env.SUPABASE_URL as string;
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY as string;
---

<Layout title="Ficha de proveedor" canonical={false}>
  <div
    id="ficha"
    class="col-span-12 grid grid-cols-12 gap-6"
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseKey}
  >
    <div class="col-span-12">
      <a href="/proveedores" class="text-sm font-medium text-primary hover:underline">
        ← Proveedores
      </a>
      <p class="mt-2 text-sm text-ink-soft">Cargando proveedor…</p>
    </div>
  </div>
</Layout>

<script>
  // Si la Pages Function (functions/proveedores/[id].ts) ya sirvió la ficha
  // armada, marca #ficha con data-ssr y acá no hay nada que hacer. Sin ella
  // (dev local, o la Function no pudo pedir los datos) se arma en el cliente.
  import { cargarFicha, mensajeHtml, slugValido } from '../../lib/ficha-proveedor.js';

  const cont = document.getElementById('ficha')!;
  const { supabaseUrl, supabaseKey, ssr } = cont.dataset;

  /** /proveedores/{slug} (rewrite) o ?id= (acceso directo a la cáscara). */
  function slugProveedor(): string | null {
    const m = location.pathname.match(/\/proveedores\/([^/]+)\/?$/);
    return slugValido(
      m && m[1] !== 'detalle'
        ? decodeURIComponent(m[1])
        : new URLSearchParams(location.search).get('id'),
    );
  }

  async function cargar() {
    const slug = slugProveedor();
    if (!slug) {
      cont.innerHTML = mensajeHtml('Falta el identificador del proveedor en la URL.');
      return;
    }
    try {
      const ficha = await cargarFicha({ supabaseUrl: supabaseUrl!, supabaseKey: supabaseKey! }, slug);
      if (!ficha) {
        cont.innerHTML = mensajeHtml(
          'No encontramos este proveedor. Puede que el enlace esté vencido o mal escrito.',
        );
        return;
      }
      document.title = ficha.titulo;
      cont.innerHTML = ficha.html;
    } catch (e) {
      cont.innerHTML = mensajeHtml(
        `No pudimos cargar el proveedor (${e instanceof Error ? e.message : e}). Probá recargar la página.`,
      );
    }
  }

  if (!ssr) cargar();
</script>
