---
import Layout from '../../layouts/Layout.astro';

// Página única (cáscara) para el detalle de compra: 130k compras como
// páginas estáticas superan el límite de 20k archivos de Cloudflare Pages.
// En producción /compras/{id} lo atiende la Pages Function
// functions/compras/[id].ts, que toma esta cáscara y le inyecta el detalle
// armado (título, descripción, canonical y contenido). En dev el middleware
// hace el rewrite y el script de abajo lo arma en el cliente. La publishable
// key es pública por diseño (solo lectura vía RLS); la Function también la
// lee de acá.
const supabaseUrl = import.meta.env.SUPABASE_URL as string;
const supabaseKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY as string;
---

<Layout title="Detalle de compra" canonical={false}>
  <div
    id="detalle"
    class="col-span-12 grid grid-cols-12 gap-6"
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseKey}
  >
    <div class="col-span-12">
      <a href="/compras" class="text-sm font-medium text-primary hover:underline">← Compras</a>
      <p class="mt-2 text-sm text-ink-soft">Cargando compra…</p>
    </div>
  </div>
</Layout>

<script>
  // Si la Pages Function (functions/compras/[id].ts) ya sirvió el detalle
  // armado, marca #detalle con data-ssr y acá solo queda apuntar «← Compras»
  // a la última búsqueda. Sin ella (dev local, o la Function no pudo pedir
  // los datos) se arma en el cliente.
  import { cargarCompra, idValido, mensajeHtml } from '../../lib/ficha-compra.js';
  import { urlVolverCompras } from '../../lib/busqueda.js';

  const cont = document.getElementById('detalle')!;
  const { supabaseUrl, supabaseKey, ssr } = cont.dataset;

  // «← Compras» vuelve a la última búsqueda del buscador (si la hay).
  const hrefVolver = urlVolverCompras();
  const apuntarVolver = () =>
    cont.querySelector<HTMLAnchorElement>('a[href="/compras"]')?.setAttribute('href', hrefVolver);
  apuntarVolver();

  /** /compras/{id} (rewrite) o ?id= (acceso directo a la cáscara). */
  function idCompra(): string | null {
    const m = location.pathname.match(/\/compras\/([^/]+)\/?$/);
    return idValido(
      m && m[1] !== 'detalle'
        ? decodeURIComponent(m[1])
        : new URLSearchParams(location.search).get('id'),
    );
  }

  async function cargar() {
    const id = idCompra();
    if (!id) {
      cont.innerHTML = mensajeHtml('Falta el identificador de la compra en la URL.', hrefVolver);
      return;
    }
    try {
      const ficha = await cargarCompra({ supabaseUrl: supabaseUrl!, supabaseKey: supabaseKey! }, id);
      if (!ficha) {
        cont.innerHTML = mensajeHtml(
          `No encontramos la compra ${id}. Puede que sea anterior a los datos cargados (desde 2025).`,
          hrefVolver,
        );
        return;
      }
      document.title = ficha.titulo;
      cont.innerHTML = ficha.html;
      apuntarVolver();
    } catch (e) {
      cont.innerHTML = mensajeHtml(
        `No pudimos cargar la compra (${e instanceof Error ? e.message : e}). Probá recargar la página.`,
        hrefVolver,
      );
    }
  }

  if (!ssr) cargar();
</script>
